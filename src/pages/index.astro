---
import Base from '../layouts/Base.astro';
import Tag from '../components/Tag.astro';
import { site } from '../data';
---
<Base tab="home">
  <section class="home">
    <div>
      <h1 class="name" aria-label="Lukas Chin">{'Lukas Chin'.split(' ').map((w, i) => <>{i > 0 && ' '}<span class="word" aria-hidden="true">{[...w].map((c) => <span class="ch">{c}</span>)}</span></>)}</h1>
      <p class="role">Software Engineer</p>
      <p class="blurb">I'm a full-stack engineer who has worked in high-growth startups, owning features end to end. I love building and solving problems, and I write code with the user's experience first.</p>
      <p class="looking">Based in New York City. Looking for full-stack or product roles in NYC (in-person or remote). Open to broader software and forward-deployed engineering roles.</p>
      <div class="mail">
        <span class="mail-addr">{site.email}</span>
        <button class="copy" type="button" data-copy={site.email}>Copy email</button>
      </div>
    </div>
    <div class="home-photo">
      <Tag>
        <img class="t-photo portrait" src="/img/home/portrait.jpg" width="800" height="1000" alt="Lukas Chin smiling, wearing a grey cardigan and pink tee" />
        <Fragment slot="back">
          <p class="t-eye">At a glance</p>
          <dl class="glance">
            <div><dt>Last role</dt><dd>Software Engineer @ VideoNest</dd></div>
            <div><dt>Studied</dt><dd>Computer Engineering @ Boston University '25</dd></div>
            <div><dt>Based in</dt><dd>New York City, open to in-person or remote</dd></div>
            <div><dt>Looking for</dt><dd>Full-stack, SWE, and FDE roles</dd></div>
            <div><dt>Stack I reach for</dt><dd>TypeScript, React, Next.js, Python, FastAPI, Postgres</dd></div>
          </dl>
        </Fragment>
      </Tag>
    </div>
  </section>
</Base>
