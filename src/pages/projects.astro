---
import Base from '../layouts/Base.astro';
import Tag from '../components/Tag.astro';
import { projects } from '../data';
---
<Base tab="projects" title="Projects">
  <header class="ph"><h2>Projects</h2></header>
  <div class="rack">
    {projects.map((p) => (
      <Tag>
        <p class="t-eye">Project</p>
        <h3 class="t-title">{p.name}</h3>
        <p class="t-body">{p.blurb}</p>
        <Fragment slot="back">
          <p class="t-eye">Built with</p>
          <div class="chips">{p.stack.map((s) => <span>{s}</span>)}</div>
          {p.highlight && <><p class="t-eye">Highlight</p><p class="t-body">{p.highlight}</p></>}
          {p.points && <ul class="t-list">{p.points.map((x) => <li>{x}</li>)}</ul>}
          {p.link && <a class="t-link" href={p.link} target="_blank" rel="noopener">View on GitHub ↗</a>}
        </Fragment>
      </Tag>
    ))}
  </div>
</Base>
