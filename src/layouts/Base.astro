---
import '../styles/global.css';
import { G, GK, garment } from '../garment';
import { site } from '../data';

interface Props { tab: 'home' | 'about' | 'experience' | 'projects' | 'misc'; title?: string }
const { tab, title } = Astro.props;
const tabs = [['home', 'Home', '/'], ['about', 'About', '/about'], ['experience', 'Experience', '/experience'], ['projects', 'Projects', '/projects'], ['misc', 'Misc', '/misc']];
const colors = Object.fromEntries(Object.entries(G).map(([k, g]) => [k, [g.bg, g.fg, g.muted, g.accent, g.scheme, g.prompt]]));
const svgs = Object.fromEntries(GK.map((k) => [k, garment(k)]));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} · Lukas Chin` : 'Lukas Chin'}</title>
    <meta name="description" content="Lukas Chin, junior full-stack software engineer." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&display=swap" />
    <!-- only the ">" glyph, for the terminal-style prompts -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@600&text=%3E&display=swap" />
    <!-- apply the saved colorway before first paint so pages never flash olive -->
    <script is:inline define:vars={{ colors }}>
      try {
        const c = colors[localStorage.getItem('lc-g')];
        if (c) {
          const r = document.documentElement.style;
          ['--bg', '--fg', '--muted', '--accent'].forEach((p, i) => r.setProperty(p, c[i]));
          r.colorScheme = c[4];
          r.setProperty('--prompt', c[5]);
        }
        // intro plays on the first page of a visit and on refresh, not when moving between tabs
        const nav = performance.getEntriesByType('navigation')[0];
        if ((!sessionStorage.getItem('lc-seen') || (nav && nav.type === 'reload')) && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.documentElement.classList.add('intro');
        }
        sessionStorage.setItem('lc-seen', '1');
      } catch (_) {}
    </script>
  </head>
  <body>
    <div class="intro-veil" aria-hidden="true"><div class="intro-g"></div></div>
    <script is:inline define:vars={{ svgs }}>
      // show whichever garment the visitor last picked (olive cardigan by default)
      try { document.querySelector('.intro-g').innerHTML = svgs[localStorage.getItem('lc-g')] || svgs.cardigan; } catch (_) { document.querySelector('.intro-g').innerHTML = svgs.cardigan; }
    </script>
    <div class="site">
      <header class="nav">
        <div class="brand-row">
          <a class="brand" href="/">Lukas Chin</a>
          <a class="ico" href={site.github} target="_blank" rel="noopener" aria-label="GitHub"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"/></svg></a>
          <a class="ico" href={site.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 110-4.12 2.06 2.06 0 010 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg></a>
        </div>
        <nav class="tabs" aria-label="Sections">
          {tabs.map(([key, label, href]) => <a class="tab" href={href} aria-current={key === tab ? 'page' : undefined}>{label}</a>)}
        </nav>
        <button class="hanger-btn" id="hangerBtn" type="button" aria-label={`Change colorway. Wearing ${G.cardigan.name}.`}>
          <svg class="wardrobe" viewBox="0 0 100 110" aria-hidden="true">
            <rect class="wb" x="14" y="4" width="72" height="100" rx="5" />
            <path class="wb" d="M18 16h64M24 104v4M76 104v4" fill="none" />
            <path class="door dl" d="M14 4L2 10v88l12 6z" />
            <path class="door dr" d="M86 4l12 6v88l-12 6z" />
          </svg>
          <Fragment set:html={garment('cardigan')} /><small>tap to change</small>
        </button>
      </header>
      <main><slot /></main>
      <footer class="foot"><span>Lukas Chin · {site.email}</span><span id="wearing">Wearing: {G.cardigan.name}</span></footer>
    </div>

    <script>
      import { G, GK, garment, type GarmentKey } from '../garment';

      const reduce = matchMedia('(prefers-reduced-motion: reduce)');
      const saved = (() => { try { return localStorage.getItem('lc-g'); } catch { return null; } })();
      let cur: GarmentKey = saved && saved in G ? (saved as GarmentKey) : 'cardigan';
      const hanger = document.getElementById('hangerBtn')!;

      function sync() {
        const g = G[cur];
        const r = document.documentElement.style;
        r.setProperty('--bg', g.bg); r.setProperty('--fg', g.fg); r.setProperty('--muted', g.muted); r.setProperty('--accent', g.accent); r.setProperty('--prompt', g.prompt);
        r.colorScheme = g.scheme;
        hanger.querySelector('.g')!.outerHTML = garment(cur);
        hanger.setAttribute('aria-label', `Change colorway. Wearing ${g.name}.`);
        document.getElementById('wearing')!.textContent = `Wearing: ${g.name}`;
      }
      if (cur !== 'cardigan') sync();

      // Colorway swap: the new garment flies from the hanger to the center, dips into the page,
      // then the page repaints in its colors from a circle in the center out.
      let busy = false;
      function wear(k: GarmentKey, from?: Element) {
        const go = () => { cur = k; try { localStorage.setItem('lc-g', k); } catch {} sync(); };
        if (reduce.matches) { go(); busy = false; return; }
        // garment starts at the hanger, or centered on whatever was clicked (the About easter egg)
        const h = hanger.querySelector('.g')!.getBoundingClientRect();
        const o = (from ?? hanger.querySelector('.g')!).getBoundingClientRect();
        const b = { width: h.width, height: h.height, left: o.left + o.width / 2 - h.width / 2, top: o.top + o.height / 2 - h.height / 2 };
        hanger.classList.remove('in');
        hanger.classList.add('out');
        const fly = document.createElement('div');
        fly.className = 'fly';
        fly.innerHTML = garment(k);
        Object.assign(fly.style, { left: `${b.left}px`, top: `${b.top}px`, width: `${b.width}px`, height: `${b.height}px` });
        document.body.append(fly);
        const dx = innerWidth / 2 - (b.left + b.width / 2), dy = innerHeight / 2 - (b.top + b.height / 2);
        const s = Math.min(170, innerWidth * 0.4) / b.width;
        fly.animate([
          { transform: 'translate(0, 0) scale(1)', opacity: 0.4 },
          { transform: `translate(${dx}px, ${dy}px) scale(${s})`, opacity: 1, offset: 0.55, easing: 'ease-in-out' },
          { transform: `translate(${dx}px, ${dy}px) scale(${s})`, opacity: 1, offset: 0.72, easing: 'ease-in' },
          { transform: `translate(${dx}px, ${dy + 8}px) scale(${s * 0.72})`, opacity: 0 },
        ], { duration: 1500, easing: 'cubic-bezier(.4,0,.2,1)', fill: 'forwards' }).finished.then(() => {
          fly.remove();
          const settle = () => { go(); hanger.classList.remove('out'); hanger.classList.add('in'); };
          if (!document.startViewTransition) { settle(); busy = false; return; }
          const root = document.documentElement;
          root.classList.add('vt-clip');
          const t = document.startViewTransition(settle);
          t.ready.then(() => root.animate({ clipPath: ['circle(0px at 50% 50%)', `circle(${Math.hypot(innerWidth, innerHeight) / 2}px at 50% 50%)`] },
            { duration: 900, easing: 'cubic-bezier(.5,0,.2,1)', pseudoElement: '::view-transition-new(root)' })).catch(() => {});
          t.finished.finally(() => { root.classList.remove('vt-clip'); busy = false; });
        });
      }

      // nav layout: one row if it fits; otherwise tabs wrap under the name and hanger; drop Home if still too tight
      const navEl = document.querySelector<HTMLElement>('.nav')!;
      const tabsEl = navEl.querySelector<HTMLElement>('.tabs')!;
      function fitNav() {
        navEl.classList.remove('stacked', 'tight');
        const wrapped = tabsEl.offsetTop > navEl.querySelector<HTMLElement>('.brand-row')!.offsetTop + 8 || hanger.offsetTop > tabsEl.offsetTop + 8;
        if (wrapped || tabsEl.scrollWidth > tabsEl.clientWidth) {
          navEl.classList.add('stacked');
          if (tabsEl.scrollWidth > tabsEl.clientWidth) navEl.classList.add('tight');
        }
      }
      fitNav();
      addEventListener('resize', fitNav);
      document.fonts.ready.then(fitNav);

      // after a few seconds, nudge visitors toward the hanger until they try it during this visit
      const tried = (() => { try { return sessionStorage.getItem('lc-tried'); } catch { return null; } })();
      const nudge = tried ? 0 : setTimeout(() => hanger.classList.add('nudge'), 6000);
      hanger.addEventListener('pointerenter', () => { clearTimeout(nudge); hanger.classList.remove('nudge'); });

      function tryOn(from?: Element) {
        if (busy) return;
        busy = true;
        clearTimeout(nudge);
        hanger.classList.remove('nudge');
        try { sessionStorage.setItem('lc-tried', '1'); } catch {}
        wear(GK[(GK.indexOf(cur) + 1) % GK.length], from);
      }
      hanger.addEventListener('click', () => tryOn());
      document.querySelectorAll('.fit-egg').forEach((egg) => egg.addEventListener('click', () => tryOn(egg)));

      // intro: remove the veil once the page has filled in
      const veil = document.querySelector('.intro-veil');
      veil?.addEventListener('animationend', (e) => {
        if ((e as AnimationEvent).animationName === 'introHole') { veil.remove(); document.documentElement.classList.remove('intro'); }
      });

      // hang tags: flip on click, keep the hidden face out of tab order
      function flip(tag: HTMLElement, force?: boolean) {
        const hadFocus = tag.contains(document.activeElement);
        const on = tag.classList.toggle('flipped', force);
        (tag.querySelector('.front') as HTMLElement).inert = on;
        (tag.querySelector('.back') as HTMLElement).inert = !on;
        if (hadFocus) tag.querySelector<HTMLElement>(on ? '.back .turn' : '.front .turn')?.focus({ preventScroll: true });
        // stop a playing video when its tag turns over; muted loops resume when it turns back
        tag.querySelectorAll('video').forEach((v) => { if (on) v.pause(); else if (v.muted) v.play().catch(() => {}); });
      }

      // put a photo or video from the back of a tag onto its front
      function show(tag: HTMLElement, d: DOMStringMap) {
        const sound = 'sound' in d;
        let el: HTMLElement;
        let video: HTMLVideoElement | undefined;
        if (d.video) {
          video = Object.assign(document.createElement('video'), { src: d.video, poster: d.src, playsInline: true, muted: !sound, loop: !sound, controls: sound });
          video.setAttribute('aria-label', d.alt!);
          el = video;
          if (sound) {
            // performance: video centered in the photo-sized frame, piece name underneath
            el = document.createElement('figure');
            el.className = 't-stage';
            el.append(video, Object.assign(document.createElement('figcaption'), { textContent: d.title ?? '' }));
          }
        } else {
          el = Object.assign(document.createElement('img'), { src: d.src, alt: d.alt });
        }
        el.classList.add('t-photo');
        el.dataset.photo = '';
        tag.querySelector('[data-photo]')!.replaceWith(el);
        // hover caption on the front; performances already show their title under the video
        const cap = tag.querySelector('.t-cap');
        if (cap) cap.textContent = sound ? '' : d.title ?? '';
        video?.play().catch(() => {});
      }

      document.addEventListener('click', (e) => {
        const t = e.target as HTMLElement;
        const copy = t.closest<HTMLElement>('[data-copy]');
        if (copy) {
          const done = (msg: string) => { copy.textContent = msg; setTimeout(() => (copy.textContent = 'Copy email'), 1600); };
          navigator.clipboard.writeText(copy.dataset.copy!).then(() => done('Copied'), () => done('Select and copy'));
          return;
        }
        const thumb = t.closest<HTMLElement>('.thumb');
        if (thumb) {
          const tag = thumb.closest<HTMLElement>('.tag')!;
          show(tag, thumb.dataset);
          tag.querySelectorAll('.thumb').forEach((x) => x.setAttribute('aria-current', String(x === thumb)));
          flip(tag, false);
          return;
        }
        if (t.closest('a, .t-stage')) return;
        const tag = t.closest<HTMLElement>('.tag[data-flip]');
        if (tag) flip(tag);
      });
    </script>
  </body>
</html>
